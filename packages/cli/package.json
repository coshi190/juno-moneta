{
    "name": "@coshi190/junoswap-cli",
    "version": "0.1.0",
    "description": "1:1 command line surface over the SDK config module",
    "private": true,
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/coshi190/junoswap-core.git",
        "directory": "packages/cli"
    },
